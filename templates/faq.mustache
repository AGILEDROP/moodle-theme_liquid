{{!
    @template theme_liquid/faq

    Front page FAQ.

    Example context (json):
    {
        "faqtitle": "Example Title",
        "faqdescription": "Example description.",
        "questions": [
            {"faqid": 1, "isfirst": true, "faqquestion": "First question?", "faqanswer": "First answer."},
            {"faqid": 2, "isfirst": false, "faqquestion": "Second question?", "faqanswer": "Second answer."}
        ]
    }
}}

<div class="frontpage-faq row mb-5">
    <div class="col-md-4">
        <h2 class="h1">{{{faqtitle}}}</h2>
        <div class="faq-description">
            {{{faqdescription}}}
        </div>
    </div>
    <div class="col-md-8">
        <div class="accordion" id="faq-frontpage">
            {{#questions}}
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faq-heading-{{{faqid}}}">
                        <button class="accordion-button {{^isfirst}}collapsed{{/isfirst}}" type="button"
                                data-bs-toggle="collapse" data-bs-target="#faq-content-{{{faqid}}}"
                                aria-expanded="{{#isfirst}}true{{/isfirst}}{{^isfirst}}false{{/isfirst}}"
                                aria-controls="faq-content-{{{faqid}}}">
                            {{{faqquestion}}}
                        </button>
                    </h3>

                    <div id="faq-content-{{{faqid}}}" class="accordion-collapse collapse {{#isfirst}}show{{/isfirst}}"
                         aria-labelledby="faq-heading-{{{faqid}}}" data-bs-parent="#faq-frontpage">
                        <div class="accordion-body">
                            {{{faqanswer}}}
                        </div>
                    </div>
                </div>
            {{/questions}}
        </div>
    </div>
</div>
