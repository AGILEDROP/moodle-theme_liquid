{{!
    @template theme_boost/courseindexdrawercontrols

    Liquid: the Moodle 5.3 expand/collapse all toggle as an icon-only button, shown on the
    course index heading line next to the close button (see theme_boost/drawers).
    The divider below the heading is rendered by theme_boost/drawers.

    Example context (json):
    {
    }
}}
<div id="courseindexdrawercontrols">
    <button type="button"
            class="courseindex-collapsemenu btn btn-icon icon-size-2"
            aria-expanded="true"
            data-action="toggleallcourseindexsections">
        <span class="collapseall">{{#pix}} t/collapseall, core, {{#str}}collapseall{{/str}} {{/pix}}</span>
        <span class="expandall">{{#pix}} t/expandall, core, {{#str}}expandall{{/str}} {{/pix}}</span>
    </button>
</div>
{{#js}}
    require(['theme_boost/courseindexdrawercontrols'], function(component) {
    component.init('courseindexdrawercontrols');
    });
{{/js}}
