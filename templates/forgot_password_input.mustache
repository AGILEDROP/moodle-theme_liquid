{{!
    @template theme_liquid/forgot_password_input

    Password recovery search input. Uses the standard form wrapper to retain
    labels, validation feedback and Moodle's form behaviour.

    Example context (json):
    {
        "label": "Username",
        "inputplaceholder": "Username",
        "inputicon": "i/user",
        "element": {
            "wrapperid": "fitem_id_username",
            "id": "id_username",
            "iderror": "id_error_username",
            "name": "username",
            "type": "text",
            "hiddenlabel": true
        }
    }
}}
{{< core_form/element-template }}
    {{$element}}
        <div class="login-input-wrapper w-100">
            <span class="login-input-icon" aria-hidden="true">
                {{#pix}}{{inputicon}}, core{{/pix}}
            </span>
            <input type="text"
                class="form-control {{#error}}is-invalid{{/error}}"
                name="{{element.name}}"
                id="{{element.id}}"
                value="{{element.value}}"
                placeholder="{{inputplaceholder}}"
                {{#element.frozen}}
                    readonly {{#element.hardfrozen}}disabled{{/element.hardfrozen}}
                {{/element.frozen}}
                {{#element.size}}size="{{element.size}}"{{/element.size}}
                {{#error}}autofocus aria-describedby="{{element.iderror}}"{{/error}}
                {{#required}}aria-required="true"{{/required}}
                {{{element.attributes}}}>
        </div>
    {{/element}}
{{/ core_form/element-template }}
